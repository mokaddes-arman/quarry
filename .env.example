# =============================================================================
# Quarry - environment configuration
# Copy this file to `.env` and adjust. NEVER commit the real `.env`.
#   PowerShell:  Copy-Item .env.example .env
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
# 0.0.0.0 listens on all interfaces (needed on Render and other container hosts).
# Set to 127.0.0.1 for a local-only server.
HOST=0.0.0.0
# Render sets PORT automatically; 3001 is the local default.
PORT=3001
LOG_LEVEL=info
# Comma separated list of allowed browser origins for the API (CORS).
# Vite dev server default is http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Database ----------------------------------------------------------------
# OPTION A (recommended for production): a real PostgreSQL server with pgvector.
#   DATABASE_URL=postgres://quarry_user:change_me@localhost:5432/quarry
# Supabase session pooler (port 5432) with verified TLS:
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=./certs/prod-ca-2021.crt
# The CA is read from server/certs/prod-ca-2021.crt, resolved from the server
# code rather than the current working directory, so it also works on Render.
# Download the public CA from Supabase Database Settings -> SSL Configuration.
# Optional: DB_CA_CERT overrides the bundled file with the certificate contents
# (literal \n line breaks are supported).
# DB_CA_CERT=
# Leave it EMPTY to use the bundled zero-install embedded PostgreSQL (PGlite)
# with the real pgvector extension. See README for details.
DATABASE_URL=
# Directory used for the embedded database when DATABASE_URL is empty.
PGLITE_DIR=./storage/pgdata

# --- Secrets -----------------------------------------------------------------
# 32+ character master key used to encrypt provider API keys at rest (AES-256-GCM).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_MASTER_KEY=change_me_to_a_long_random_secret_at_least_32_chars

# --- Storage -----------------------------------------------------------------
# Local filesystem storage (development/tests). When Supabase Storage is
# configured below, this directory is only used for temporary upload files.
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=20

# Optional private Supabase Storage. Enable it by setting ALL THREE values.
# Create the bucket as PRIVATE - never expose it through a public URL. Uploads
# and downloads go through this server, which keeps the existing project/user
# authorization checks in place.
# SUPABASE_SERVICE_ROLE_KEY is a server-only secret. Never put it in the web
# client, commit it, or expose it with a VITE_/PUBLIC_ prefix.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=quarry-documents
# Logo object-key folder in the same bucket (defaults to external_logo).
# SUPABASE_LOGO_FOLDER=external_logo

# --- Accounts / sign-in ------------------------------------------------------
# Users sign in with a password or a single-use link sent by email.
# On first run, if ADMIN_EMAIL is set the first administrator is created and a
# login link is printed to the server console. Leave it empty to use the
# first-run setup screen in the web app instead.
# ADMIN_EMAIL=you@yourcompany.com
# ADMIN_NAME=Administrator
# Absolute URL used in emailed links and the widget embed snippet. Set this in
# production, e.g. https://quarry.onrender.com (also add it to CORS_ORIGIN).
# APP_PUBLIC_URL=http://localhost:5173
AUTH_TOKEN_TTL_MINUTES=30
AUTH_SESSION_DAYS=14
# Secure cookies require HTTPS. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=false

# --- Email (SMTP) ------------------------------------------------------------
# Without SMTP the app still works: login links are printed to the server log
# and shown once to the administrator so they can be handed over manually.
# Any SMTP provider works (Resend, SendGrid, Mailgun, Gmail app password, ...).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=change_me
# MAIL_FROM=Quarry <no-reply@example.com>
# MAIL_REPLY_TO=support@example.com

# --- Chunking / ingestion ----------------------------------------------------
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=180
INGESTION_CONCURRENCY=1
INGESTION_MAX_ATTEMPTS=3

# --- Embeddings (local by default; no cloud call required) -------------------
# provider: local | ollama | openai | hash | cloudflare
DEFAULT_EMBEDDING_PROVIDER=local
DEFAULT_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# Vector dimension stored in the database. MUST match DEFAULT_EMBEDDING_MODEL.
#   Xenova/all-MiniLM-L6-v2      -> 384
#   Xenova/bge-small-en-v1.5     -> 384
#   Xenova/all-mpnet-base-v2     -> 768
#   ollama:nomic-embed-text      -> 768
#   openai:text-embedding-3-small-> 1536
#   @cf/baai/bge-small-en-v1.5   -> 384
#   @cf/baai/bge-base-en-v1.5    -> 768 (requires EMBEDDING_DIM=768)
#   @cf/baai/bge-m3              -> 1024 (requires EMBEDDING_DIM=1024)
EMBEDDING_DIM=384
# Local model cache directory (transformers.js / Hugging Face).
HF_HOME=./storage/models

# --- Cloudflare Workers AI (Embeddings) --------------------------------------
# Account ID from Cloudflare dashboard
WORKER_ACCOUNT_ID=
# API token with Workers AI Edit permissions for the account
WORKER_API_KEY=

# --- LLM (hosted) ------------------------------------------------------------
# Only two providers can answer questions: OpenRouter and Groq.
# These are only DEFAULTS; real provider keys are configured in the UI and stored
# encrypted in the database. Never put real keys in this file.
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# When true the backend refuses to call any hosted LLM (privacy mode).
DISABLE_HOSTED_AI=false

# --- OpenRouter (default) ---------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model used when no provider configuration is stored in the database.
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,deepseek/deepseek-chat-v3-0324

# --- Groq (fallback) --------------------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3-32b

# --- Retrieval tuning --------------------------------------------------------
RETRIEVAL_TOP_K=8
RETRIEVAL_VECTOR_CANDIDATES=30
RETRIEVAL_KEYWORD_CANDIDATES=30
RETRIEVAL_MIN_SCORE=0.0
# Drop vector-only matches scoring below this fraction of the best match
# (0.35 = keep anything at least 35% as similar as the top hit; 0 disables).
RETRIEVAL_RELATIVE_CUTOFF=0.35
RETRIEVAL_MAX_CONTEXT_CHARS=16000
RETRIEVAL_RERANK_ENABLED=false

# --- Request timeouts (ms) ---------------------------------------------------
LLM_REQUEST_TIMEOUT_MS=120000
# Maximum silence before a streaming answer is aborted.
LLM_STREAM_IDLE_TIMEOUT_MS=60000
EMBEDDING_REQUEST_TIMEOUT_MS=60000

# --- Deadlines for the ask flow and the ingestion pipeline (ms) -------------
# Every stage of a question has a budget, so the UI can never hang.
ASK_TIMEOUT_MS=180000
RETRIEVAL_TIMEOUT_MS=60000
DB_QUERY_TIMEOUT_MS=30000
INGESTION_PARSE_TIMEOUT_MS=180000
INGESTION_JOB_TIMEOUT_MS=900000
# A "processing" job older than this is treated as orphaned and re-queued.
INGESTION_STALE_JOB_MS=1200000

# --- Web crawling (web links, link lists, re-crawls) ------------------------
# The crawler is SSRF-safe by default: only http/https, no credentials, and
# loopback/link-local/private hosts are refused (each redirect hop is checked).
# Set CRAWL_ALLOW_PRIVATE_HOSTS=true only on a trusted machine.
CRAWL_TIMEOUT_MS=30000
# Hard cap on one downloaded page.
CRAWL_MAX_BYTES=5242880
CRAWL_MAX_REDIRECTS=5
CRAWL_MAX_ATTEMPTS=3
CRAWL_CONCURRENCY=1
CRAWL_USER_AGENT=QuarryBot/1.0 (knowledge-base crawler)
CRAWL_ALLOW_PRIVATE_HOSTS=false
# A "processing" crawl job older than this is treated as orphaned and re-queued.
CRAWL_STALE_JOB_MS=300000
